# GoldHunter AI — Environment Configuration Template
# Copy this file to .env and fill in your private credentials.
# NEVER commit your actual .env with live keys to GitHub.

# --- Core Platform Settings ---
ENVIRONMENT=production
DEBUG=false
PORT=8000
HOST=0.0.0.0

# --- Trading Mode: 'PAPER', 'EXNESS_DEMO', or 'EXNESS_REAL' ---
TRADING_MODE=PAPER
LIVE_TRADING_ENABLED=false
EXNESS_CONFIRM_REAL_TRADING=false

# --- Instrument ---
SYMBOL=XAUUSD

# --- Official Exness Trading API Credentials ---
# Ed25519 Request Signing is enforced across all Exness REST & WebSocket endpoints
# Main DNS: api.exness.com | Alternative DNS: api.exness-api.com
EXNESS_API_BASE_URL=https://api.exness.com
EXNESS_API_ALT_BASE_URL=https://api.exness-api.com
EXNESS_API_KEY=your_exness_public_api_key_here
EXNESS_PRIVATE_SIGNING_KEY=your_ed25519_private_key_hex_or_pem_or_b64
EXNESS_PRIVATE_KEY_B64=your_ed25519_private_key_here
EXNESS_ACCOUNT_ID=your_exness_account_number_here
EXNESS_MOCK_MODE=false

# --- xKiro AI Engine (OpenAI-compatible) ---
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_API_KEY=your_xkiro_api_key_here
XKIRO_PRIMARY_MODEL=qwen/qwen3.7-max:free
XKIRO_FALLBACK_MODEL=qwen/qwen3.7-flash:free

# --- Telegram Owner Control Center Bot ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_OWNER_ID=your_numeric_telegram_user_id

# --- Sevalla Managed PostgreSQL Database ---
# For local dev defaults to SQLite; on Sevalla provide the PostgreSQL connection URI:
DATABASE_URL=postgresql://user:password@hostname:5432/goldhunter

# --- Deterministic Risk Engine Limits ---
MAX_RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=2.0
MAX_TRADES_PER_DAY=5
MAX_CONSECUTIVE_LOSSES=2
MIN_RISK_REWARD=2.0

# --- Partial Profit-Taking Rules ---
TP1_RR=1.0
TP1_CLOSE_PCT=0.40
TP2_RR=2.0
TP2_CLOSE_PCT=0.30
TP3_RR=3.0
TP3_CLOSE_PCT=0.30

# --- High-Impact News Blackout Window (Minutes) ---
NEWS_BLACKOUT_MINUTES_BEFORE=30
NEWS_BLACKOUT_MINUTES_AFTER=30

# --- Security & Dashboard ---
JWT_SECRET=generate_a_secure_random_secret_string
DASHBOARD_PASSWORD=set_a_strong_dashboard_password
